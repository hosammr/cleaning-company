{
	"name": "hds-onderhoudsdiensten",
	"private": true,
	"type": "module",
	"scripts": {
		"build:scss": "sass wp-content/themes/hds/src/scss/main.scss wp-content/themes/hds/assets/css/main.css --style=compressed --no-source-map",
		"build:css": "postcss wp-content/themes/hds/assets/css/main.css -o wp-content/themes/hds/assets/css/main.min.css",
		"build:editor-css": "postcss wp-content/themes/hds/assets/css/editor.css -o wp-content/themes/hds/assets/css/editor.min.css",
		"build:js": "esbuild wp-content/themes/hds/assets/js/main.js --bundle --minify --outfile=wp-content/themes/hds/assets/js/main.min.js",
		"build:blocks": "esbuild wp-content/themes/hds/assets/js/blocks/*.js --bundle --minify --outdir=wp-content/themes/hds/assets/js/blocks/dist --out-extension:.js=.min.js",
		"build": "npm run build:css && npm run build:editor-css && npm run build:js && npm run build:blocks",
		"dev:css": "postcss wp-content/themes/hds/assets/css/main.css -o wp-content/themes/hds/assets/css/main.min.css --watch",
		"dev": "npm run build && npm run dev:css",
		"lint:css": "stylelint wp-content/themes/hds/assets/css/**/*.css",
		"lint:js": "eslint wp-content/themes/hds/assets/js/**/*.js",
		"lint": "npm run lint:css && npm run lint:js",
		"fix:css": "stylelint wp-content/themes/hds/assets/css/**/*.css --fix",
		"fix:js": "eslint wp-content/themes/hds/assets/js/**/*.js --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "is-ci || husky || true"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"autoprefixer": "^10.5.4",
		"cssnano": "^7.1.9",
		"esbuild": "^0.24.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.0.0",
		"husky": "^9.1.7",
		"postcss": "^8.4.0",
		"postcss-cli": "^11.0.0",
		"prettier": "^3.0.0",
		"sass": "^1.101.6",
		"stylelint": "^16.0.0",
		"stylelint-config-standard": "^36.0.0"
	},
	"browserslist": [
		"> 0.5%",
		"last 2 versions",
		"Firefox ESR",
		"not dead"
	]
}
