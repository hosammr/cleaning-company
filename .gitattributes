# Auto-detect text files
* text=auto

# PHP files
*.php text eol=lf diff=php

# CSS/JS
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonc text eol=lf

# Config
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
.env.example text eol=lf
.env.* text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Shell
*.sh text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose.yml text eol=lf
