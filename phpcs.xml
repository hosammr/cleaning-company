<?xml version="1.0"?>
<ruleset name="HDS Onderhoudsdiensten">
  <description>WordPress coding standards for HDS theme</description>

  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <arg name="parallel" value="8"/>
  <arg name="basepath" value="."/>

  <file>wp-content/themes/hds/</file>

  <exclude-pattern>/vendor/</exclude-pattern>
  <exclude-pattern>/node_modules/</exclude-pattern>
  <exclude-pattern>/assets/</exclude-pattern>

  <config name="minimum_supported_wp_version" value="6.7"/>
  <config name="testVersion" value="8.2-"/>

  <rule ref="WordPress-Core">
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
  </rule>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress.Security"/>
  <rule ref="WordPress.PHP"/>
  <rule ref="WordPress.DB"/>
  <rule ref="WordPress.WP"/>

  <rule ref="PHPCompatibilityWP"/>

  <rule ref="Generic.Arrays.DisallowShortArraySyntax">
    <severity>0</severity>
  </rule>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" value="hds"/>
    </properties>
  </rule>

  <rule ref="WordPress.WP.EnqueuedResourceParameters">
    <exclude-pattern>assets/</exclude-pattern>
  </rule>
</ruleset>
