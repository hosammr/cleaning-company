{
	"extends": ["stylelint-config-standard"],
	"ignoreFiles": ["**/*.min.css"],
	"rules": {
		"selector-class-pattern": [
			"^(wc-|woocommerce|woocommerce-MyAccount-navigation|wp-block|is-style|has-|[a-z]([a-z0-9_-]+)?(__([a-z0-9]+-?)+)?(--([a-z0-9]+-?)+){0,2})$",
			{
				"resolveNestedSelectors": true,
				"message": "Expected class selector \"%s\" to match pattern \"%s\""
			}
		],
		"selector-id-pattern": [
			"^(wc-|[a-z]([a-z0-9-]+)?(__([a-z0-9]+-?)+)?(--([a-z0-9]+-?)+){0,2}|place_order|payment)$",
			{
				"message": "Expected id selector \"%s\" to match pattern \"%s\""
			}
		],
		"custom-property-pattern": null,
		"function-no-unknown": [true, {
			"ignoreFunctions": ["theme", "var"]
		}],
		"at-rule-no-unknown": [true, {
			"ignoreAtRules": ["custom-media", "container", "layer", "apply", "screen"]
		}],
		"declaration-block-no-duplicate-properties": [true, {
			"ignore": ["consecutive-duplicates-with-different-values"]
		}],
		"length-zero-no-unit": true,
		"no-descending-specificity": null,
		"no-invalid-position-at-import-rule": null,
		"media-feature-range-notation": null,
		"rule-empty-line-before": null
	}
}
